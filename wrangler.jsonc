{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feed-back-api",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "vars": {
    "GITHUB_REPOSITORY": "yychuiyan/feed-back",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://yychuiyan.github.io,http://127.0.0.1:4173"
  },
  "ratelimits": [{"name":"SUBMISSION_LIMITER","namespace_id":"1001","simple":{"limit":5,"period":60}}]
}
